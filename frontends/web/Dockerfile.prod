# ── Build stage ─────────────────────────────────────────────────────────────
FROM node:22-alpine AS builder

WORKDIR /app

COPY package.json package-lock.json ./
COPY frontends/web/package.json frontends/web/
COPY frontends/mobile/package.json frontends/mobile/
COPY libs/shared-types/package.json libs/shared-types/
COPY libs/api-client/package.json libs/api-client/
COPY libs/design-tokens/package.json libs/design-tokens/

RUN npm ci

COPY . .

RUN npm run build -w frontends/web

# ── Runtime stage ───────────────────────────────────────────────────────────
FROM nginx:1.27-alpine

RUN addgroup -S -g 1000 app && adduser -S -u 1000 -G app app

COPY --from=builder /app/frontends/web/dist /usr/share/nginx/html
COPY frontends/web/nginx.conf /etc/nginx/conf.d/default.conf

RUN chown -R app:app /usr/share/nginx/html /var/cache/nginx /var/run

USER app
EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
