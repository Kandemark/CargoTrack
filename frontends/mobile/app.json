{
  "expo": {
    "name": "CargoTrack",
    "slug": "cargotrack",
    "version": "0.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "cargotrack",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0f2d5e"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.cargotrack.app"
    },
    "android": {
      "package": "com.cargotrack.app",
      "allowBackup": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon-foreground.png",
        "backgroundColor": "#F5801E"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "./plugins/withSplashTimeout",
      "expo-router",
      "expo-secure-store",
      "expo-local-authentication",
      "expo-notifications",
      "expo-location",
      "expo-document-picker",
      "expo-image-picker"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "6422b5f4-6a71-4151-b1be-74b20383f590"
      }
    },
    "owner": "kandemark"
  }
}
