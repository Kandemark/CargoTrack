# Development only. Copy to .env.local (ignored by git) and fill in.
# Release builds take these from the EAS environment ("preview",
# "production") and refuse to build with missing, http or local values.

# CargoTrack core API, e.g. https://api.example.com
EXPO_PUBLIC_API_URL=
# Zitadel instance, e.g. https://cargotrack-abc123.zitadel.cloud
EXPO_PUBLIC_OIDC_ISSUER=
# Zitadel application (type: native / user agent, PKCE, no secret)
EXPO_PUBLIC_OIDC_CLIENT_ID=
# Zitadel project ID, requested as the token audience
EXPO_PUBLIC_OIDC_PROJECT_ID=
