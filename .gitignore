# ═══════════════════════════════════════════════════════════════════════════════
# CargoTrack .gitignore — Comprehensive ignore rules for security & hygiene.
# ═══════════════════════════════════════════════════════════════════════════════

# ── Secrets, credentials & tokens ─────────────────────────────────────────────
# Never commit any file that might contain secrets — even stubs.
.env
.env.*
!.env.example
.envrc
.env.production
.env.staging
*.token
*.secret
*_secret*
secrets/
secrets.*/
credentials.json
credentials.*.json
*_credentials.*
service-account.json
service-account.*.json
*.service-account.json
sa-key.json
sa-key.*.json
gcp-*.json
aws-*.json
*.pem
*.key
*.crt
*.cer
*.der
*.p12
*.pfx
*.pkcs12
*.pkcs8
*.ppk
*.mobileprovision
*.p8
*.jks
*.keystore
*.keytab
*.keychain
*.ovpn
*.opvn
id_rsa*
id_ed25519*
id_ecdsa*
id_dsa*
id_*.pub  # public keys are fine, but pair patterns catch private keys
ssh_host_*_key
ssh_host_*_key.pub
*.kdbx
*.kdb
*.vault
*.vault.yml
ansible-vault-password*
.vault-token
.vault_pass*
sealed-secrets.yaml
sealed-secrets-*.yaml
secrets.auto.tfvars
*.auto.tfvars.json
terraform.tfvars
*.tfvars
override.tf.json

# Cloud provider credential files
.aws/
.gcp/
.azure/
.config/gcloud/

# Kubernetes — kubeconfig contains cluster credentials
kubeconfig*
*.kubeconfig
.kube/

# API key files that slip through
api_key*
apikey*
# Scoped to credential-like extensions to avoid catching source files
*_apikey.txt
*_apikey.json
*_apikey.pem
*_apikey.key
*_api_key*
appsettings.*.json  # often contains connection strings

# OAuth / OIDC client secrets
client_secret*.json
oauth*.secret
oidc*.secret

# ── Certificates & private keys (additional patterns) ─────────────────────────
*.p7b
*.p7c
*.spc
*.csr
certs/
certificates/
tls/
ssl/
*.chain.pem
*.fullchain.pem
*.privkey.pem

# ── Database dumps, backups & data files ─────────────────────────────────────
*.dump
*.pgdump
*.sql.gz
*.sql.bz2
*.sql.xz
*.sql.zst
dump.*
dump_*
*.backup.sql
*.backup
*.bck
*.bak
*.bkp
backup/
backups/
db_backup/
db_backups/
data/backups/

# ── Environment & runtime ────────────────────────────────────────────────────
/.env.local
/.env.*.local
.env.development.local
.env.test.local
.env.production.local
*.local.env

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
eggs/
.eggs/
*.manifest
*.spec
*.whl
pip-wheel-metadata/
.python-version
*.egg

# Virtual environments
.venv/
venv/
env/
.env/
.venv-*/
virtualenv/
.pip-*/

# ── Django ────────────────────────────────────────────────────────────────────
*.log
local_settings.py
local_settings_*.py
settings_local.py
settings_local_*.py
db.sqlite3
db.sqlite3-journal
*.sqlite3
media/
staticfiles/
collected-static/
schema.openapi.yml

# Note: Django migrations (*/migrations/*.py) MUST be committed — they are NOT
# regenerated per-environment and are required for CI/test/deploy.

# ── Node / JavaScript / TypeScript ────────────────────────────────────────────
node_modules/
*.tsbuildinfo
*.tsbuildinfo.*
.npm/
.npmrc
!frontends/*/.npmrc
.yarn/
.yarnrc
.yarnrc.yml
.yarn-integrity
package-lock.json

# Frontend env files
frontends/*/.env
frontends/*/.env.local
frontends/*/.env.*.local
frontends/*/.env.development
frontends/*/.env.test
frontends/*/.env.production

# Vite
frontends/web/dist/
frontends/web/.vite/

# Next.js (if adopted later)
.next/
out/

# Expo
.expo/
*.jks
*.keystore

# NPM debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*

# ── Go ────────────────────────────────────────────────────────────────────────
# Compiled binaries
services/tracking-ingest/tracking-server.exe
services/tracking-ingest/tracking-server
services/notification/notification.exe
services/notification/notification
services/webhook-dispatcher/webhook-dispatcher.exe
services/webhook-dispatcher/webhook-dispatcher
*.exe
*.test
*.out
vendor/

# ── Rust ──────────────────────────────────────────────────────────────────────
**/target/
services/gps-ingest/gps-ingest.exe
services/gps-ingest/gps-ingest
services/route-optimizer/route-optimizer.exe
services/route-optimizer/route-optimizer
